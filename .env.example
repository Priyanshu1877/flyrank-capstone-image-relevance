# Environment Configuration Template
# COPY TO .env AND POPULATE WITH LOCAL CREDENTIALS. DO NOT COMMIT .env TO VERSION CONTROL.

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Note: Local development connects to PostgreSQL on port 5433
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5433/flyrank_image_relevance?sslmode=disable
TEST_DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5433/flyrank_test?sslmode=disable

# AI Provider Configuration (Phase 3+)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# AI Cost Budget Guard
AI_MAX_BUDGET_USD=5.0000

# Matching & Mismatch Guard Engine Thresholds
# Initial provisional threshold (tuned empirically during Phase 5 evaluation)
INITIAL_MATCH_SIMILARITY_THRESHOLD=0.720
MIN_VISION_CONFIDENCE=0.700
QUARANTINE_VISION_CONFIDENCE=0.400

# Background Worker Settings
JOB_POLL_INTERVAL_MS=3000
JOB_MAX_ATTEMPTS=3
JOB_BASE_BACKOFF_MS=5000

# Default Tenant Configuration for Local Development
DEFAULT_TENANT_ID=e1f1c7d2-3498-4c1d-84fb-39074742a001
DEFAULT_TENANT_NAME="Default Editorial Tenant"
